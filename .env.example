# MetalScope Environment Configuration Template
# Copy this file to .env or configure in local.properties / gradle.properties

# ── Primary Market Data Provider ──────────────────────────────────────────────
# metalcharts.org — official live prices (XAU, XAG, XPT, XPD, HG, etc.)
# Endpoint: https://api.metalcharts.org/v1/prices
# Docs:     https://metalcharts.org/api/docs
METALCHARTS_API_KEY=mc_live_811e23945324ed30ed238ba3052177e27e1e11f43fed7f9b88ffa3aaa3127461

# ── Fallback Market Data Providers (no key needed) ────────────────────────────
# Yahoo Finance  — https://query1.finance.yahoo.com  (free, no key)
# gold-api.com   — https://api.gold-api.com          (free tier)
# frankfurter.app— https://api.frankfurter.app       (forex: free, no key)

# ── Legacy / Optional Providers ───────────────────────────────────────────────
# These are no longer used by default but kept for reference
METALS_API_KEY=your_metals_api_key_here
METALS_API_BASE_URL=https://www.goldapi.io/api

# Refresh Rate Configuration (in seconds: 10, 30, 60, or 0 for manual)
DEFAULT_REFRESH_INTERVAL=15

# Default App Configuration
DEFAULT_CURRENCY=USD
DEFAULT_WEIGHT_UNIT=OZ
DEFAULT_THEME=DARK
